from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.button import Button
from kivy.uix.label import Label
from kivy.uix.textinput import TextInput
from kivy.uix.scrollview import ScrollView
import random
import datetime
import json
import os
import ast
import operator

ARQUIVO = "memoria_suprema.json"

def carregar_memoria():
    if os.path.exists(ARQUIVO):
        try:
            with open(ARQUIVO, "r", encoding="utf-8") as f:
                dados = json.load(f)
                if isinstance(dados, dict):
                    dados.setdefault("notas", [])
                    dados.setdefault("tarefas", [])
                    return dados
        except Exception:
            pass
    return {"notas": [], "tarefas": []}

memoria = carregar_memoria()

def guardar_memoria():
    try:
        with open(ARQUIVO, "w", encoding="utf-8") as f:
            json.dump(memoria, f, ensure_ascii=False, indent=2)
    except Exception:
        pass

class SupremaApp(App):
    def build(self):
        self.title = "6000 IA Suprema Interativa"
        
        layout_principal = BoxLayout(orientation='vertical', padding=10, spacing=6)
        
        # Título
        self.titulo_label = Label(
            text="6000 IA SUPREMA - INTERATIVA\nCriador: Jose Marques",
            size_hint_y=None,
            height=45,
            halign='center'
        )
        layout_principal.add_widget(self.titulo_label)
        
        # Campo de Entrada de Texto
        self.input_texto = TextInput(
            text="",
            hint_text="Escreve aqui uma tarefa, nota ou conta matemática...",
            size_hint_y=None,
            height=40,
            multiline=False
        )
        layout_principal.add_widget(self.input_texto)
        
        # Área de Visualização / Texto (Scroll)
        scroll = ScrollView(size_hint=(1, 0.4))
        self.resultado_label = Label(
            text="Bem-vindo! Usa a caixa acima para escrever e escolhe uma acao abaixo.",
            halign='center',
            valign='middle',
            size_hint_y=None,
            height=200
        )
        self.resultado_label.bind(
            width=lambda s, w: setattr(s, 'text_size', (w - 20, None)),
            texture_size=lambda s, t: setattr(s, 'height', max(200, t[1]))
        )
        scroll.add_widget(self.resultado_label)
        layout_principal.add_widget(scroll)
        
        # Botões de Ação Interativa
        btn_add_tarefa = Button(text="Adicionar Tarefa", background_color=(0.1, 0.5, 0.8, 1))
        btn_add_tarefa.bind(on_press=self.adicionar_tarefa)
        layout_principal.add_widget(btn_add_tarefa)
        
        btn_add_nota = Button(text="Guardar Nota", background_color=(0.8, 0.5, 0.1, 1))
        btn_add_nota.bind(on_press=self.adicionar_nota)
        layout_principal.add_widget(btn_add_nota)
        
        btn_ver_tudo = Button(text="Ver Tarefas e Notas", background_color=(0.7, 0.3, 0.8, 1))
        btn_ver_tudo.bind(on_press=self.ver_tudo)
        layout_principal.add_widget(btn_ver_tudo)
        
        btn_calcular = Button(text="Calcular Expressao (Logica)", background_color=(0.1, 0.7, 0.4, 1))
        btn_calcular.bind(on_press=self.calcular_logica)
        layout_principal.add_widget(btn_calcular)
        
        btn_humor = Button(text="IA do Humor", background_color=(0.3, 0.6, 0.6, 1))
        btn_humor.bind(on_press=self.executar_humor)
        layout_principal.add_widget(btn_humor)
        
        btn_sair = Button(text="Sair", background_color=(0.8, 0.2, 0.2, 1))
        btn_sair.bind(on_press=self.parar_app)
        layout_principal.add_widget(btn_sair)
        
        return layout_principal

    def adicionar_tarefa(self, instance):
        texto = self.input_texto.text.strip()
        if texto:
            memoria["tarefas"].append({"texto": texto, "concluida": False})
            guardar_memoria()
            self.resultado_label.text = f"Sucesso! Tarefa guardada:\n'{texto}'"
            self.input_texto.text = ""
        else:
            self.resultado_label.text = "Aviso: Escreve algo na caixa de texto primeiro!"

    def adicionar_nota(self, instance):
        texto = self.input_texto.text.strip()
        if texto:
            memoria["notas"].append(texto)
            guardar_memoria()
            self.resultado_label.text = f"Sucesso! Nota guardada:\n'{texto}'"
            self.input_texto.text = ""
        else:
            self.resultado_label.text = "Aviso: Escreve algo na caixa de texto primeiro!"

    def ver_tudo(self, instance):
        tarefas = memoria.get("tarefas", [])
        notas = memoria.get("notas", [])
        
        res = "--- MEMORIA GUARDADA ---\n\n[TAREFAS]:\n"
        if not tarefas:
            res += "Nenhuma tarefa.\n"
        else:
            for i, t in enumerate(tarefas, 1):
                estado = "OK" if t.get("concluida") else "PENDENTE"
                res += f"{i}. [{estado}] {t['texto']}\n"
                
        res += "\n[NOTAS]:\n"
        if not notas:
            res += "Nenhuma nota.\n"
        else:
            for i, n in enumerate(notas, 1):
                res += f"{i}. {n}\n"
                
        self.resultado_label.text = res

    def calcular_logica(self, instance):
        expressao = self.input_texto.text.strip()
        if not expressao:
            self.resultado_label.text = "Aviso: Escreve uma expressao matematica na caixa (ex: 50+25*2)."
            return
        
        try:
            resultado = eval(expressao, {"__builtins__": {}}, {})
            self.resultado_label.text = f"Expressao: {expressao}\nResultado: {resultado}"
        except Exception:
            self.resultado_label.text = "Erro: Expressao matematica invalida."

    def executar_humor(self, instance):
        piadas = [
            "Porque o computador foi ao medico? Porque tinha um virus!",
            "O programador ficou com fome porque perdeu os cookies.",
            "O Python foi à escola aprender a contar os espaços."
        ]
        self.resultado_label.text = f"--- IA DO HUMOR ---\n\n{random.choice(piadas)}"

    def parar_app(self, instance):
        App.get_running_app().stop()

if __name__ == '__main__':
    SupremaApp().run()
