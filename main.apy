from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.button import Button
from kivy.uix.label import Label
from kivy.uix.scrollview import ScrollView
import random
import datetime
import json
import os

ARQUIVO = "memoria_suprema.json"

def carregar_memoria():
    if os.path.exists(ARQUIVO):
        try:
            with open(ARQUIVO, "r", encoding="utf-8") as f:
                dados = json.load(f)
                if isinstance(dados, dict):
                    dados.setdefault("notas", [])
                    dados.setdefault("tarefas", [])
                    return dados
        except Exception:
            pass
    return {"notas": [], "tarefas": []}

memoria = carregar_memoria()

def guardar_memoria():
    try:
        with open(ARQUIVO, "w", encoding="utf-8") as f:
            json.dump(memoria, f, ensure_ascii=False, indent=2)
    except Exception:
        pass

class SupremaApp(App):
    def build(self):
        self.title = "6000 IA Suprema"
        
        layout_principal = BoxLayout(orientation='vertical', padding=10, spacing=6)
        
        # Título
        self.titulo_label = Label(
            text="6000 IA SUPREMA - GESTOR COMPLETO\nCriador: Jose Marques",
            size_hint_y=None,
            height=50,
            halign='center'
        )
        layout_principal.add_widget(self.titulo_label)
        
        # Área de Visualização / Texto
        scroll = ScrollView(size_hint=(1, 0.45))
        self.resultado_label = Label(
            text="Bem-vindo! Clica numa opcao abaixo para interagir.",
            halign='center',
            valign='middle',
            size_hint_y=None,
            height=250
        )
        self.resultado_label.bind(
            width=lambda s, w: setattr(s, 'text_size', (w - 20, None)),
            texture_size=lambda s, t: setattr(s, 'height', max(250, t[1]))
        )
        scroll.add_widget(self.resultado_label)
        layout_principal.add_widget(scroll)
        
        # Botões do Menu Principal
        btn_humor = Button(text="1. IA do Humor", background_color=(0.1, 0.5, 0.8, 1))
        btn_humor.bind(on_press=self.executar_humor)
        layout_principal.add_widget(btn_humor)
        
        btn_tempo = Button(text="2. Previsao do Tempo (Floriano)", background_color=(0.1, 0.7, 0.4, 1))
        btn_tempo.bind(on_press=self.executar_tempo)
        layout_principal.add_widget(btn_tempo)
        
        btn_tarefas = Button(text="3. Ver Tarefas Guardadas", background_color=(0.7, 0.3, 0.8, 1))
        btn_tarefas.bind(on_press=self.executar_tarefas)
        layout_principal.add_widget(btn_tarefas)
        
        btn_notas = Button(text="4. Ver Notas Guardadas", background_color=(0.8, 0.5, 0.1, 1))
        btn_notas.bind(on_press=self.executar_notas)
        layout_principal.add_widget(btn_notas)
        
        btn_seguranca = Button(text="5. Dicas de Seguranca", background_color=(0.3, 0.6, 0.6, 1))
        btn_seguranca.bind(on_press=self.executar_seguranca)
        layout_principal.add_widget(btn_seguranca)
        
        btn_sair = Button(text="0. Sair", background_color=(0.8, 0.2, 0.2, 1))
        btn_sair.bind(on_press=self.parar_app)
        layout_principal.add_widget(btn_sair)
        
        return layout_principal

    def executar_humor(self, instance):
        piadas = [
            "Porque o computador foi ao medico? Porque tinha um virus!",
            "O programador ficou com fome porque perdeu os cookies.",
            "O Python foi à escola aprender a contar os espaços."
        ]
        self.resultado_label.text = f"--- IA DO HUMOR ---\n\n{random.choice(piadas)}"

    def executar_tempo(self, instance):
        self.resultado_label.text = (
            "--- PREVISAO DO TEMPO (FLORIANO) ---\n\n"
            "Temperatura: 31°C\n"
            "Condicao: Céu limpo / Ensolarado\n"
            "Humidade: 55%\n"
            "Vento: 12 km/h"
        )

    def executar_tarefas(self, instance):
        tarefas = memoria.get("tarefas", [])
        if not tarefas:
            texto = "--- GESTOR DE TAREFAS ---\n\nNenhuma tarefa guardada na memoria."
        else:
            texto = "--- GESTOR DE TAREFAS ---\n\n"
            for i, t in enumerate(tarefas, 1):
                estado = "CONCLUIDA" if t.get("concluida") else "PENDENTE"
                texto += f"{i}. [{estado}] {t['texto']}\n"
        self.resultado_label.text = texto

    def executar_notas(self, instance):
        notas = memoria.get("notas", [])
        if not notas:
            texto = "--- MEMORIA DE NOTAS ---\n\nAinda nao ha notas guardadas."
        else:
            texto = "--- MEMORIA DE NOTAS ---\n\n"
            for i, n in enumerate(notas, 1):
                texto += f"{i}. {n}\n"
        self.resultado_label.text = texto

    def executar_seguranca(self, instance):
        self.resultado_label.text = (
            "--- SEGURANCA DIGITAL ---\n\n"
            "1. Usa passwords fortes e unicas.\n"
            "2. Ativa sempre a autenticação de dois fatores (2FA).\n"
            "3. Nunca cliques em links suspeitos.\n"
            "4. Mantém o sistema atualizado."
        )

    def parar_app(self, instance):
        App.get_running_app().stop()

if __name__ == '__main__':
    SupremaApp().run()
